{
  "name": "personakit",
  "version": "0.1.0",
  "private": true,
  "description": "Keep one sourced record of who you are. Compile an AI brief and a cited CV draft from it.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "personakit": "bin/personakit.mjs"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
